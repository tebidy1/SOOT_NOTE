{
    "name": "laracore/core",
    "description": "Core package containing Master Controller, Model, Trait, and Helper classes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "LaraCore Team",
            "email": "dev@laracore.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaraCore\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraCore\\CoreServiceProvider"
            ],
            "commands": [
                "LaraCore\\Console\\Commands\\ListLaraCoreRoutes"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
