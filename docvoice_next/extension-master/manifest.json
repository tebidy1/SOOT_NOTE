{
  "manifest_version": 3,
  "name": "SoutNote | صوت نوت",
  "version": "1.0.0",
  "description": "Medical voice recording, transcription, and form filling assistant",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SoutNote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "index.html",
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "assets/*", "icons/*", "pcm-worklet.js", "public/*", "index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8002 http://127.0.0.1:8002 ws://localhost:8002 https://assets9.lottiefiles.com https://lottie.host https://*.lottiefiles.com https://*.oci.oraclecloud.com wss://*.oci.oraclecloud.com;"
  }
}