# ScribeFlow Medical - Environment Configuration
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env

# ──────────────────────────────────────
# رابط API الخلفي
# ──────────────────────────────────────
VITE_API_BASE_URL=https://docapi.sootnote.com/api

# ──────────────────────────────────────
# وضع تجريبي (بدون سيرفر)
# true  = بيانات وهمية تعمل بدون سيرفر
# false = اتصال حقيقي بالسيرفر (يتطلب VITE_API_BASE_URL صالح)
# ──────────────────────────────────────
VITE_DEMO_MODE=true

# ──────────────────────────────────────
# فترة استطلاع البريد الوارد (مللي ثانية)
# ──────────────────────────────────────
VITE_POLLING_INTERVAL=300000
